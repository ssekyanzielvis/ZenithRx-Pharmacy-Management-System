# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ─── SUPABASE ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API

# Your Supabase project URL
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Public anon key (safe for browser use — RLS enforced)
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Service role key (SERVER-SIDE ONLY — bypasses RLS — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# VITE_ prefixed vars are exposed to the browser bundle (used by src/lib/supabase.ts)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ─── CLOUDFLARE R2 ─────────────────────────────────────────────────────────────
# Get these from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Your Cloudflare Account ID (found in the right sidebar of the Cloudflare dashboard)
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# R2 API Token credentials (create under R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"

# Your R2 bucket name
R2_BUCKET_NAME="zenithrx-files"

# Optional: Custom public domain if the bucket is publicly accessible
# Leave empty to use only signed URLs (more secure — recommended for medical data)
R2_PUBLIC_URL=""

# ─── PAYMENT GATEWAYS & TELECOM INTEGRATION (UGANDA & GLOBAL) ─────────────────

# 1. MTN MoMo Open API (Direct Collection API)
# Get keys from: https://momodeveloper.mtn.com/ → Developer Portal
MTN_MOMO_ENVIRONMENT="sandbox" # "sandbox" or "production"
MTN_MOMO_SUBSCRIPTION_KEY="YOUR_MTN_MOMO_SUBSCRIPTION_KEY"
MTN_MOMO_API_USER="YOUR_MTN_MOMO_API_USER_UUID"
MTN_MOMO_API_KEY="YOUR_MTN_MOMO_API_KEY"
MTN_MOMO_CALLBACK_URL="http://localhost:3000/api/payments/webhook/mtn_momo"

# 2. Airtel Money Africa API (Collections)
# Get keys from: https://developers.airtel.africa/ → Merchant Portal
AIRTEL_MONEY_ENVIRONMENT="sandbox" # "sandbox" or "production"
AIRTEL_MONEY_CLIENT_ID="YOUR_AIRTEL_CLIENT_ID"
AIRTEL_MONEY_CLIENT_SECRET="YOUR_AIRTEL_CLIENT_SECRET"
AIRTEL_MONEY_COUNTRY="UG"
AIRTEL_MONEY_CURRENCY="UGX"
AIRTEL_MONEY_CALLBACK_URL="http://localhost:3000/api/payments/webhook/airtel_money"

# 3. Pesapal 3.0 API (Unified: MTN MoMo, Airtel Money, Visa, MasterCard, Amex)
# Regulated by Bank of Uganda. Get keys from: https://developer.pesapal.com/
PESAPAL_ENVIRONMENT="sandbox" # "sandbox" or "live"
PESAPAL_CONSUMER_KEY="YOUR_PESAPAL_CONSUMER_KEY"
PESAPAL_CONSUMER_SECRET="YOUR_PESAPAL_CONSUMER_SECRET"
PESAPAL_IPN_ID="YOUR_REGISTERED_PESAPAL_IPN_ID"
PESAPAL_CALLBACK_URL="http://localhost:3000/api/payments/webhook/pesapal"

# 4. Optional: Flutterwave / Stripe (Alternative Multi-Currency Gateway)
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""

